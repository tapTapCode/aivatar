#!/bin/bash
# Check if API is already running on 8765
if curl -s http://127.0.0.1:8765/health >/dev/null 2>&1; then
    echo 'API is already running'
    # Keep process alive so Tauri sidecar handle stays happy
    while true; do sleep 3600; done
else
    exec /Volumes/OSSTB/Developer/Aivatar/.venv/bin/python -m pipeline.sidecar
fi
