{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aivatar",
  "version": "0.5.0",
  "identifier": "com.aivatar.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aivatar",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/aivatar-api"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
