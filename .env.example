APP_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO
API_KEY=
AUTH_REQUIRED=true
# Keep true for local SQLite setup; set false on Vercel and run `alembic upgrade head` separately.
AUTH_AUTO_MIGRATE=true
DATABASE_URL=sqlite+aiosqlite:///artifacts/auth.db
SESSION_COOKIE_NAME=aivatar_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
AUTH_TOKEN_TTL_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Store OAuth secrets only in the deployment secret store.
# Register these redirect URIs on the Google Web client and Apple Services ID:
#   https://aivatar-staging.vercel.app/v1/auth/oauth/google/callback
#   https://aivatar-web.vercel.app/v1/auth/oauth/google/callback
#   http://localhost:3000/v1/auth/oauth/google/callback
#   https://aivatar-staging.vercel.app/v1/auth/oauth/apple/callback
#   https://aivatar-web.vercel.app/v1/auth/oauth/apple/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS8 key with literal \n separators when stored on one line.
APPLE_PRIVATE_KEY=
# Optional public origin override for OAuth redirect_uri. Defaults to APP_BASE_URL.
AUTH_CALLBACK_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Aivatar <auth@example.com>
# Verified matching emails receive the superadmin role at account creation.
SUPERADMIN_IDENTITIES=Jumar Juaton,Jorge Luis
SUPERADMIN_EMAILS=jumar.designer@gmail.com,motivaciondiaria630@gmail.com
API_RATE_LIMIT_PER_MINUTE=60
QUEUE_BACKEND=memory
# memory keeps jobs in-process; database uses the same Postgres/SQLite URL as auth.
CONTROL_PLANE_BACKEND=memory
# Postgres/Neon URLs select the durable store even if this stays memory.
JOB_CLAIM_LEASE_SECONDS=60
JOB_RUNNING_LEASE_SECONDS=600
# Use `modal` only after the Modal ingress has been deployed and the secret set.
BACKGROUND_RUNNER=inline
MODAL_DISPATCH_URL=
MODAL_DISPATCH_SECRET=
# Public Vercel callback endpoint, e.g. https://app.example.com/v1/internal/modal-jobs/{job_id}
MODAL_CALLBACK_URL=
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/data/assets
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=video-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
FINAL_VIDEO_R2_PREFIX=videos
RETAINED_DOWNLOAD_URL_SECONDS=900
MODEL_CACHE_ROOT=/models
WORK_ROOT=/data/work
TEMPLATE_ROOT=/app/templates
PROVIDER_MODE=mock
IMAGE_WORKER_URL=http://image-worker:8080
VIDEO_WORKER_URL=http://video-worker:8080
TTS_WORKER_URL=http://tts-worker:8080
LIPSYNC_WORKER_URL=http://lipsync-worker:8080
RENDER_WORKER_URL=http://render-worker:8080
AVATAR_REGISTRY_ROOT=/data/avatars
MEDIA_REGISTRY_ROOT=/data/authorized-media
MEDIA_UPLOAD_MAX_BYTES=262144000
ASSET_RETENTION_HOURS=24
VOICE_REGISTRY_ROOT=/data/voices
AVATAR_VIDEO_PROVIDER=heygen_api
LOCAL_AVATAR_PROOF=packaged/local-avatar/avatar_quality_proof.mp4
LOCAL_AVATAR_IMAGE=packaged/local-avatar/presenter.png
DEFAULT_AVATAR_ID=presenter-01
FORCE_MOCK_PROVIDERS=false
# Product path: HeyGen exports the presenter. Register a HeyGen avatar ID in
# studio. local_musetalk is an optional local fallback, not the client default.
HEYGEN_API_KEY=
HEYGEN_API_BASE=https://api.heygen.com
HEYGEN_ENGINE=avatar_iv
HEYGEN_VOICE_MODE=native
HEYGEN_DEFAULT_VOICE_ID=
HEYGEN_RESOLUTION=1080p
# Packaged local MuseTalk replay is $0. This rate applies only on local_musetalk.
GPU_HOURLY_RATE_USD=0.22
HEYGEN_RATE_USD_PER_MINUTE=4.0
HEYGEN_MAXIMUM_COST_USD_PER_JOB=25.0
HEYGEN_POLL_INTERVAL_SECONDS=10
HEYGEN_TIMEOUT_SECONDS=7200
HEYGEN_R2_RETENTION_ENABLED=false
HEYGEN_R2_PREFIX=retained/heygen
GPU_CONCURRENCY=1
MODEL_IDLE_UNLOAD_SECONDS=900
MAX_RETRIES=2
FLUX2_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
FLUX2_MODEL_REVISION=PIN_REQUIRED
LTX_MODEL_ID=Lightricks/LTX-Video-2.3
LTX_MODEL_REVISION=PIN_REQUIRED
MUSETALK_MODEL_REVISION=0a89dec45a0192b824e3cf4daf96c239440c5ed8
CHATTERBOX_MODEL_REVISION=5de7a54aa4e5e2baadb0182dde554908b48b85c2
MUSETALK_SOURCE_ROOT=/opt/MuseTalk
MUSETALK_MODELS_ROOT=/models
MUSETALK_BBOX_SHIFT=0
MUSETALK_TIMEOUT_SECONDS=3600
CHATTERBOX_DEVICE=cuda
FLUX2_MODEL_ADAPTER=
LTX_MODEL_ADAPTER=
MUSETALK_MODEL_ADAPTER=src.providers.local.musetalk:create_musetalk_provider
CHATTERBOX_MODEL_ADAPTER=src.providers.local.chatterbox:create_chatterbox_provider
VOICE_CONSENT_REQUIRED=true
AVATAR_CONSENT_REQUIRED=true
